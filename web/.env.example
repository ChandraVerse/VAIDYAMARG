# ============================================================
# VaidyaMarg — Web Portal (Vite + React)
# Copy to web/.env and fill in real values before running.
# NEVER commit .env to git.
# All public browser-facing vars must be prefixed with VITE_
# ============================================================

# Base URL of the NestJS backend API
# Development: http://localhost:3000/v1
# Production:  https://api.vaidyamarg.in/v1
VITE_API_URL=http://localhost:3000/v1

# Razorpay publishable key (safe to expose in browser)
# Use rzp_test_* for development, rzp_live_* for production
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
