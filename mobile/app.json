{
  "expo": {
    "name": "VaidyaMarg",
    "slug": "vaidyamarg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vaidyamarg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chandraverse.vaidyamarg",
      "infoPlist": {
        "NSCameraUsageDescription": "VaidyaMarg needs camera access to capture your prescription.",
        "NSPhotoLibraryUsageDescription": "VaidyaMarg needs photo library access to upload your prescription."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f6f2"
      },
      "package": "com.chandraverse.vaidyamarg",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "VaidyaMarg needs camera access to capture your prescription." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "VaidyaMarg needs photo library access to upload your prescription." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
