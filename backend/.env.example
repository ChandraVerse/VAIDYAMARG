# =============================================================
# VaidyaMarg Backend — Environment Variables
# Copy this file to .env and fill in real values
# =============================================================

# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vaidyamarg
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (prescription image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# MSG91 — OTP SMS provider (https://msg91.com)
# All SMS / OTP is sent via MSG91. No Twilio.
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_SENDER_ID=VDYMRG

# Firebase (FCM push notifications)
# Paste the full service-account JSON as a single line, or provide a file path
FIREBASE_SERVICE_ACCOUNT_JSON=

# OCR Microservice
OCR_SERVICE_URL=http://ocr-service:8000
INTERNAL_SECRET=change_me_internal_secret

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
