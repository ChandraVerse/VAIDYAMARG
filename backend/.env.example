# =============================================================
# VaidyaMarg Backend — Environment Variables
# Copy this file to .env and fill in real values
# =============================================================

# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vaidyamarg

# Redis
# When running via docker-compose, set host=redis (the service name).
# For local dev without Docker: host=localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Full URL form (used by BullModule)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
JWT_ACCESS_EXPIRES_IN=15m

# Cloudinary (prescription image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OTP / SMS — MSG91 (https://msg91.com)
# The sole SMS/OTP provider. DO NOT add Twilio variables — they are not used.
# In development (NODE_ENV != production), OTP is logged to console; no real SMS sent.
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_SENDER_ID=VDYMRG

# Firebase Cloud Messaging (push notifications)
# Paste the full service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=

# OCR Microservice
OCR_SERVICE_URL=http://localhost:8000
INTERNAL_SECRET=change_me_internal_secret

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
