// VaidyaMarg — Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================
model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  name       String?
  email      String?  @unique
  role       Role     @default(PATIENT)
  avatar     String?
  dateOfBirth DateTime?
  gender     String?
  isVerified Boolean  @default(false)
  isActive   Boolean  @default(true)
  fcmToken   String?  @map("fcm_token")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders          Order[]
  prescriptions   Prescription[]
  notifications   Notification[]
  refillReminders RefillReminder[]
  addresses       Address[]
  healthRecords   HealthRecord[]
  pharmacy        Pharmacy?          // if role = PHARMACIST, their pharmacy

  @@map("users")
}

enum Role {
  PATIENT
  PHARMACIST
  ADMIN
}

// ============================================================
// ADDRESS
// ============================================================
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  // e.g. "Home", "Work"
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// HEALTH RECORD
// ============================================================
model HealthRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // ALLERGY | CONDITION | SURGERY | MEDICATION
  name        String
  details     String?
  severity    String?  // MILD | MODERATE | SEVERE
  diagnosedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("health_records")
}

// ============================================================
// PHARMACY PARTNER
// ============================================================
model Pharmacy {
  id               String          @id @default(cuid())
  ownerId          String          @unique
  owner            User            @relation(fields: [ownerId], references: [id])

  name             String
  licenseNumber    String          @unique
  gstNumber        String?
  email            String?         @unique
  phone            String
  address          String
  city             String
  state            String
  pincode          String

  status           PharmacyStatus  @default(PENDING)
  rejectionReason  String?
  approvedById     String?
  approvedAt       DateTime?

  drugLicenseUrl   String?
  gstCertUrl       String?
  ownerIdUrl       String?

  isActive         Boolean         @default(false)
  operatingHours   String?
  deliveryRadius   Int?
  commissionRate   Float           @default(10)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  earnings         PharmacyEarning[]

  @@map("pharmacies")
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ============================================================
// PHARMACY EARNINGS
// ============================================================
model PharmacyEarning {
  id           String   @id @default(cuid())
  pharmacyId   String
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderId      String   @unique
  orderAmount  Float
  commission   Float
  netEarning   Float
  settledAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([pharmacyId, createdAt])
  @@map("pharmacy_earnings")
}

// ============================================================
// MEDICINE
// ============================================================
model Medicine {
  id           String   @id @default(cuid())
  name         String
  genericName  String
  brandName    String?
  manufacturer String?
  category     String
  dosageForm   String
  strength     String
  mrp          Float
  genericPrice Float
  discount     Float    @default(0)
  stock        Int      @default(0)
  imageUrl     String?
  requiresRx   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems      OrderItem[]
  refillReminders RefillReminder[]

  @@map("medicines")
}

// ============================================================
// ORDER
// ============================================================
model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  prescriptionId  String?
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  status          OrderStatus   @default(PENDING)
  totalAmount     Float
  genericSavings  Float         @default(0)  @map("generic_savings")
  deliveryAddress String        // snapshot of address at order time
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  quantity   Int
  unitPrice  Float
  totalPrice Float

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ============================================================
// PRESCRIPTION
// ============================================================
model Prescription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  imageUrl         String
  publicId         String?
  status           PrescriptionStatus @default(PENDING)
  fileType         String?
  fileName         String?
  fileSize         Int?
  ocrData          Json?
  ocrResult        String?
  ocrProcessedAt   DateTime?
  medicines        Json?
  doctorName       String?
  patientName      String?
  issuedDate       DateTime?
  verifiedById     String?
  verifiedAt       DateTime?
  rejectionReason  String?
  pharmacistNotes  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  orders Order[]

  @@map("prescriptions")
}

enum PrescriptionStatus {
  PENDING
  VERIFIED
  REJECTED
  OCR_PROCESSING
  OCR_COMPLETE
}

// ============================================================
// NOTIFICATION
// ============================================================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  metadata  String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PACKED
  ORDER_DISPATCHED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PRESCRIPTION_VERIFIED
  PRESCRIPTION_REJECTED
  LOW_STOCK_ALERT
  PAYMENT_SUCCESS
  REFILL_REMINDER
  PARTNER_APPROVED
  PARTNER_REJECTED
  PARTNER_SUSPENDED
}

// ============================================================
// REFILL REMINDER
// ============================================================
model RefillReminder {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  intervalDays Int      @default(30)
  enabled      Boolean  @default(true)
  nextRemindAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, medicineId])
  @@map("refill_reminders")
}
