# Google Cloud Vision (preferred engine)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcloud.json

# Fallback: set to "tesseract" if no GCloud credentials
OCR_ENGINE=google   # google | tesseract

# NestJS backend callback URL
BACKEND_CALLBACK_URL=http://backend:3000/api/v1/prescriptions/ocr-result
BACKEND_INTERNAL_SECRET=super_secret_internal_key

# Redis (for job queue)
REDIS_URL=redis://redis:6379

# Service config
PORT=8000
LOG_LEVEL=info
MAX_FILE_SIZE_MB=10
