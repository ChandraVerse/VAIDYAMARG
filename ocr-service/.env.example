# ============================================================
# VaidyaMarg — OCR Microservice (Python / FastAPI)
# Copy to ocr-service/.env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# GOOGLE CLOUD VISION
# Path to your service-account JSON key file.
# Leave empty to fall back to Tesseract-only mode.
# Download from: GCP Console → IAM → Service Accounts
# ------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------
# INTERNAL SECRET
# Shared secret between OCR service and NestJS backend.
# Must match OСR_API_KEY in the root .env / backend/.env
# ------------------------------------------------------------
INTERNAL_SECRET=change-me-ocr-internal-api-key

# ------------------------------------------------------------
# BACKEND CALLBACK
# Base URL of the NestJS API — used for async OCR callbacks.
# Development: http://localhost:3000
# Docker Compose: http://backend:3000
# ------------------------------------------------------------
BACKEND_URL=http://backend:3000

# ------------------------------------------------------------
# OCR ENGINE
# "vision"     — Google Cloud Vision only
# "tesseract"  — Tesseract only (no GCP key needed)
# "auto"       — tries Vision first, falls back to Tesseract
# ------------------------------------------------------------
OCR_ENGINE=auto

# ------------------------------------------------------------
# SERVICE
# ------------------------------------------------------------
PORT=8000
