# Leave GOOGLE_APPLICATION_CREDENTIALS empty to fall back to Tesseract-only mode
GOOGLE_APPLICATION_CREDENTIALS=

# Secret shared with the NestJS backend to authenticate OCR callbacks
INTERNAL_SECRET=changeme

# Base URL of the NestJS API (used for async callbacks)
BACKEND_URL=http://api:3000

# OCR engine preference: "vision" | "tesseract" | "auto" (tries Vision first, falls back)
OCR_ENGINE=auto

PORT=8000
