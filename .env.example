# ============================================================
# VAIDYAMARG — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to Git!
# ============================================================

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=VaidyaMarg
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ------------------------------------------------------------
# DATABASE — PostgreSQL (Primary DB)
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vaidyamarg_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=vaidyamarg
DATABASE_URL=postgresql://vaidyamarg_user:your_postgres_password_here@localhost:5432/vaidyamarg

# ------------------------------------------------------------
# DATABASE — MongoDB (Prescription & Unstructured Data)
# ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/vaidyamarg
MONGODB_DB_NAME=vaidyamarg

# ------------------------------------------------------------
# CACHE — Redis
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# AUTH — JWT
# ------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ------------------------------------------------------------
# FILE STORAGE — Cloudinary
# (For prescription images & medicine photos)
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=vaidyamarg_prescriptions

# ------------------------------------------------------------
# PAYMENTS — Razorpay
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------
# SMS / OTP — MSG91
# ------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_otp_template_id
MSG91_SENDER_ID=VAIDYA
MSG91_OTP_EXPIRY_MINUTES=10

# Fallback SMS provider — Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------
# PUSH NOTIFICATIONS — Firebase Cloud Messaging (FCM)
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVER_KEY=your_firebase_server_key

# ------------------------------------------------------------
# AI / OCR MICROSERVICE — Python FastAPI
# ------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=your_internal_api_key_for_ai_service
TESSERACT_CMD_PATH=/usr/bin/tesseract
OCR_CONFIDENCE_THRESHOLD=0.75

# Veryfi OCR API (optional — fallback for printed prescriptions)
VERYFI_CLIENT_ID=your_veryfi_client_id
VERYFI_CLIENT_SECRET=your_veryfi_client_secret
VERYFI_USERNAME=your_veryfi_username
VERYFI_API_KEY=your_veryfi_api_key

# ------------------------------------------------------------
# EMAIL — (for admin notifications)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@vaidyamarg.in

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
ENABLE_OCR=true
ENABLE_HANDWRITTEN_OCR=false
ENABLE_TELEMEDICINE=false
ENABLE_LAB_TESTS=false
MAINTENANCE_MODE=false
